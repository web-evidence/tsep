{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tsep:report-schema:0.1.0-draft.3",
  "title": "TSEP scoped assessment report (draft)",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "2"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": {
          "const": "TSEP"
        },
        "version": {
          "const": "0.1.0-draft.3"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "assessor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "manual",
            "semiAuto",
            "automatic"
          ]
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "mode"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "selection_method": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "label",
        "targets",
        "selection_method",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "custom",
        "TSEP-1",
        "TSEP-2",
        "TSEP-3"
      ]
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TS01",
          "TS02",
          "TS03",
          "TS04",
          "TS05",
          "TS06",
          "TS07",
          "TS08",
          "TS09",
          "TS10",
          "TS11",
          "TS12",
          "TS13",
          "TS14",
          "TS15",
          "TS16",
          "TS17",
          "TS18",
          "TS19",
          "TS20",
          "TS21",
          "TS22",
          "TS23",
          "TS24",
          "TS25",
          "TS26",
          "TS27",
          "TS28",
          "TS29",
          "TS30",
          "TS31",
          "TS32",
          "TS33",
          "TS34",
          "TS35",
          "TS36",
          "TS37",
          "TS38",
          "TS39",
          "TS40",
          "TS41",
          "TS42",
          "TS43",
          "TS44"
        ]
      },
      "minItems": 1
    },
    "claim": {
      "const": "scoped-assessment"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "change-history",
              "ci-output",
              "configuration",
              "content",
              "crawl",
              "field-data",
              "hreflang",
              "html",
              "http",
              "intent",
              "inventory",
              "lab-data",
              "logs",
              "operator-docs",
              "render",
              "robots",
              "search-console",
              "sitemap",
              "structured-data",
              "tls",
              "validator-output",
              "webmaster-tools"
            ]
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "enum": [
              "public",
              "restricted",
              "synthetic"
            ]
          },
          "engine": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "kind",
          "observed_at",
          "targets",
          "description",
          "access"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control_id": {
            "type": "string",
            "enum": [
              "TS01",
              "TS02",
              "TS03",
              "TS04",
              "TS05",
              "TS06",
              "TS07",
              "TS08",
              "TS09",
              "TS10",
              "TS11",
              "TS12",
              "TS13",
              "TS14",
              "TS15",
              "TS16",
              "TS17",
              "TS18",
              "TS19",
              "TS20",
              "TS21",
              "TS22",
              "TS23",
              "TS24",
              "TS25",
              "TS26",
              "TS27",
              "TS28",
              "TS29",
              "TS30",
              "TS31",
              "TS32",
              "TS33",
              "TS34",
              "TS35",
              "TS36",
              "TS37",
              "TS38",
              "TS39",
              "TS40",
              "TS41",
              "TS42",
              "TS43",
              "TS44"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "C",
              "NC",
              "NA",
              "NT"
            ]
          },
          "evaluation_state": {
            "type": "string",
            "enum": [
              "complete",
              "not-started",
              "inconclusive"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "evaluated_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "atomic_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "not-applicable",
                    "inconclusive"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "rule_id",
                "target",
                "outcome",
                "reason",
                "evidence_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "control_id",
          "status",
          "evaluation_state",
          "reason",
          "procedure",
          "evaluated_targets",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "format_version",
    "protocol",
    "issued_at",
    "assessor",
    "scope",
    "profile",
    "controls",
    "claim",
    "artifacts",
    "results"
  ],
  "additionalProperties": false
}
