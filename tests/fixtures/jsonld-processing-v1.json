{
  "kind": "authored-jsonld-processing-expectations",
  "version": "1",
  "synthetic": true,
  "normative_effect": "none",
  "scope": "Finite JSON-LD expansion/flattening observations, not Schema.org validation, browser extraction, semantic facts or TS31–33 outcomes.",
  "expected_origin": "Authored before candidate supervisor/worker implementation; only a one-document package availability probe had run. W3C JSON-LD 1.1 syntax and pinned jsonld.js event names consulted.",
  "backend": "jsonld@9.0.0, bundled dist/jsonld.esm.js, Node 24; no implicit network contexts",
  "cases": [
    {
      "id": "inline-context",
      "document": {
        "id": "document",
        "base_iri": "https://example.test/page",
        "raw_json": "{\"@context\":{\"name\":\"https://schema.org/name\"},\"@id\":\"#org\",\"name\":\"Example\"}"
      },
      "contexts": [],
      "expected": {
        "status": "observed",
        "expanded": [
          {
            "@id": "https://example.test/page#org",
            "https://schema.org/name": [
              {
                "@value": "Example"
              }
            ]
          }
        ],
        "notice_codes": []
      }
    },
    {
