{
  "kind": "authored-jsonld-html-script-observation-expectations",
  "version": "1",
  "synthetic": true,
  "normative_effect": "none",
  "scope": "Inventory all script elements under each static HTML parsing hypothesis, including inert/foreign records. Each expected list retains parsed ID/type/text/template/namespace; this does not decide MIME eligibility, visible content, document graph or TS31–33.",
  "expected_origin": "Authored and frozen before any JSON-LD HTML extraction reader or execution of these inputs; existing general parse5 source tools predate this fixture. Primary W3C/HTML sources and method discussion retained separately.",
  "cases": [
    {
      "id": "head-block",
      "html": "<!doctype html><html><head><script id=\"s\" type=\"application/ld+json\">{}</script></head><body></body></html>",
      "expected": {
        "enabled": [
          {
            "id": "s",
            "type": "application/ld+json",
            "payload": "{}",
            "template": false,
            "namespace": "http://www.w3.org/1999/xhtml"
          }
        ],
        "disabled": [
          {
            "id": "s",
            "type": "application/ld+json",
            "payload": "{}",
            "template": false,
            "namespace": "http://www.w3.org/1999/xhtml"
          }
        ]
      }
    },
