      "id": "cache-first-document",
      "document": {
        "id": "document",
        "base_iri": "https://example.test/page",
        "raw_json": "{\"@context\":\"https://contexts.example.test/reused\",\"name\":\"Example\"}"
      },
      "contexts": [
        {
          "url": "https://contexts.example.test/reused",
          "raw_json": "{\"@context\":{\"name\":\"https://schema.org/name\"}}",
          "sha256": "e7f54ba191b600117e8e7e11c1aef385ebebe9248ed857a727fa37d57688f04b"
        }
      ],
      "expected": {
        "status": "observed",
        "expanded": [
          {
            "https://schema.org/name": [
              {
                "@value": "Example"
              }
            ]
          }
        ]
      }
    },
    {
