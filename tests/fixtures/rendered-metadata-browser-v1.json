{
  "kind": "synthetic-browser-recipes",
  "version": "1",
  "normative": false,
  "plan": "rendered-metadata-plan-v2.json",
  "scope": "22 browser scenarios from the 24-case design plan; broken-path and same-script are offline checks. Two extra JS/corrected bridge scenarios. Original plan unchanged.",
  "limits": {
    "nodes": 2048,
    "depth": 64,
    "tree_utf8_bytes": 524288,
    "serialization_utf8_bytes": 262144,
    "cooperative_ms": 2000,
    "invocation_timeout_ms": 5000
  },
  "cases": [
    {
      "id": "head-canonical",
      "head": "<link id=\"case-canonical\" rel=\"canonical\" href=\"{base}/product\">",
      "body": "",
      "script": "",
      "expected": {
        "canonical": {
          "case-canonical": {
            "raw_href": "{base}/product",
            "position": "head-direct"
          }
        }
      }
    },
    {
      "id": "root-auxiliary",
      "head": "<link id=\"case-canonical\" rel=\"canonical\" href=\"{base}/product\">",
      "body": "",
      "script": "const x=document.createElement('div');x.id='case-root';document.documentElement.appendChild(x);",
      "expected": {
        "nodes": {
          "case-root": {
            "position": "outside-head-body"
          }
        }
      }
    },
    {
      "id": "root-canonical",
      "head": "<link id=\"case-canonical\" rel=\"canonical\" href=\"{base}/product\">",
      "body": "",
      "script": "const x=document.createElement('div');x.id='case-root';x.innerHTML='<link id=case-outside rel=canonical href=\"{base}/other\">';document.documentElement.appendChild(x);",
      "expected": {
        "canonical": {
          "case-outside": {
            "raw_href": "{base}/other",
            "position": "outside-head-body"
          }
        }
      }
    },
    {
      "id": "custom-neutral",
      "head": "<link id=\"case-canonical\" rel=\"canonical\" href=\"{base}/product\">",
      "body": "<x-demo id=\"case-custom\">Neutral</x-demo>",
      "script": "",
